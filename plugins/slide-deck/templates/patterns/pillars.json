   "example": [
    {
     "head": "業務の見える化",
     "body": "今の手順と所要時間を一覧にして、どこに時間がかかっているかを数字で示す"
    },
    {
     "head": "小さな自動化",
     "body": "繰り返しの多い作業から順に、1 か月ごとに 1 つずつ自動化する"
    },
    {
     "head": "使いこなす人づくり",
     "body": "各部署に 1 名の推進役を置き、勉強会と相談窓口で支える"
    },
    {
     "head": "効果の測定",
     "body": "毎月同じ指標で効果を測り、経営会議に報告する"
    }
   ]
  },
  "foundation": {
   "kind": "text",

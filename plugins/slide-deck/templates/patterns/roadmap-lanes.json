   "kind": "text",
   "label": "右の列の時期（任意）",
   "max_chars": 7,
   "example": "半年以降"
  },
  "now": {
   "kind": "list",
   "label": "いまやること",
   "min": 1,
   "max": 3,
   "max_chars": 24,
   "example": [
    "棚卸の記録をタブレットに移す",
    "発注の締め時刻を前倒しする",
    "新人向けの売場マップを作る"
   ],
   "required": true,
   "description": "左の列（強調）。着手済み・今期に終えること"
  },
  "next": {
   "kind": "list",
   "label": "次にやること",
   "min": 1,
   "max": 3,
   "max_chars": 24,
   "example": [
    "特売の価格を店舗ごとに決める",
    "冷蔵ケースの配置を見直す"
   ],
   "required": true,
   "description": "中央の列。次の期に着手すること"
  },
  "later": {
   "kind": "list",
   "label": "その先にやること",
   "min": 1,
   "max": 3,
   "max_chars": 24,
   "example": [
